{
  "name": "qr-ordering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm test:unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "gate:phase1": "tsx --env-file=.env scripts/gate.ts 1",
    "gate:phase2": "tsx --env-file=.env scripts/gate.ts 2"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@node-rs/argon2": "^2.0.2",
    "@react-pdf/renderer": "^4.2.1",
    "@tanstack/react-query": "^5.67.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-intl": "^3.26.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^5.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
